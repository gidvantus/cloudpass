# Copy to `deploy/.env` on the server and fill in. Compose is pointed at this file with an
# explicit `--env-file`, so it is read from here and not from wherever the command runs.
#
# `.env` itself is ignored by git (see the repository's .gitignore); this template is not.

# The name people will type. Its DNS A (or AAAA) record must already point at this server,
# and ports 80 and 443 must reach it: Let's Encrypt validates over HTTP-01 by default, so a
# domain that resolves but cannot be reached on port 80 gets no certificate.
CLOUDPASS_DOMAIN=cloudpass.example.com

# Where Let's Encrypt sends expiry warnings. Any address you actually read.
ACME_EMAIL=you@example.com

# Leave at 0. Raise it to 1 for the single run that creates the first account on this server,
# then put it back — see docs/DEPLOY.md. Anyone who finds the address while it is 1 can create
# an account of their own.
CLOUDPASS_REGISTRATION_OPEN=0
