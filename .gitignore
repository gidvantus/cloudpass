# Build artifacts
/target
**/target

# Tauri generates permission schemas on every build; they are derived, not source.
desktop/gen/schemas/

# The Android project under desktop/gen/android is source: the manifest, the icons and the
# Gradle files are edited by hand and would be lost on the next `android init`. Only the
# build output and the machine-local paths go to the ignore list.
desktop/gen/android/.gradle/
desktop/gen/android/.kotlin/
desktop/gen/android/build/
desktop/gen/android/app/build/
desktop/gen/android/local.properties
*.jks
*.keystore

# The web portal's wasm module and its JavaScript glue. Derived, and large: run
# `scripts/build-web.ps1` after a fresh checkout, or the server has nothing to serve.
web/web/ui/pkg/

# The desktop installer, put here by `scripts/build-desktop.ps1` for the server to hand out.
# The file is ignored; the directory is kept, because the Docker build copies it and an empty
# directory means "nothing to offer" rather than a failure.
web/web/ui/download/*
!web/web/ui/download/.gitkeep

# Vendored toolchain bootstrap (rustup-init.exe and friends)
/.tools
/.cargo
/.rust

# Node
node_modules/
dist/
.pnpm-store/

# Local secrets and env
.env
.env.*
!.env.example

# Local development database
*.db
*.db-shm
*.db-wal

# Editor / OS
.vscode/
.idea/
*.suo
Thumbs.db
desktop.ini

# Crash reporter logs emitted by the Node/Electron tooling
debug.log

# Rust debugging symbols from local builds
*.pdb

# NOTE: Cargo.lock is deliberately NOT ignored. This workspace ships binaries, and the
# lock file is what makes a build reproducible from a reviewed dependency set — which
# this project treats as a supply-chain control, not a convenience.
